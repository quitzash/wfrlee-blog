{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "blog.wfrlee.com" }],
      "destination": "https://wfrlee.com/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/newsletter/send",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/ai/weekly-post",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/ai/weekly-post",
      "schedule": "30 7 * * 1"
    }
  ]
}
