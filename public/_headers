# Cloudflare Pages response headers.
#
# `public/.htaccess` and `public/web.config` carry the same policy for the
# Apache/IIS hosts, but Cloudflare Pages ignores both. This file applies the
# policy to the prerendered HTML and the static assets; `src/middleware.ts`
# applies the same values to the pages the Worker renders at request time.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
