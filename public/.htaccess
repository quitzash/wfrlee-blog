# =============================================================================
#  Wfrlee.com blog — Apache configuration
#  Upload the CONTENTS of the `dist/` folder (including this file) into
#  your hosting document root: `public_html/` on cPanel / GoDaddy.
# =============================================================================

# -----------------------------------------------------------------------------
#  Basics
# -----------------------------------------------------------------------------
# Never let Apache guess file types from extensions it doesn't know (avoids
# serving the wrong MIME type) and disable directory listings.
Options -MultiViews -Indexes

# Serve index.html for directory requests.
DirectoryIndex index.html

# All content is UTF-8.
AddDefaultCharset UTF-8

# -----------------------------------------------------------------------------
#  Force HTTPS + canonical host (non-www)
#  NOTE: If you prefer www.wfrlee.com, swap the two blocks below.
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
	RewriteEngine On

	# Redirect blog.wfrlee.com -> wfrlee.com (preserve path)
	RewriteCond %{HTTP_HOST} ^blog\.wfrlee\.com$ [NC]
	RewriteRule ^(.*)$ https://wfrlee.com/$1 [R=301,L]

	# Redirect any non-HTTPS request to HTTPS. The X-Forwarded-Proto check
	# keeps the rule safe behind a proxy / load balancer (e.g. Cloudflare).
	RewriteCond %{HTTPS} !=on
	RewriteCond %{HTTP:X-Forwarded-Proto} !https
	RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

	# Redirect www.wfrlee.com -> wfrlee.com
	RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
	RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# -----------------------------------------------------------------------------
#  Custom error documents
# -----------------------------------------------------------------------------
ErrorDocument 404 /404.html

# -----------------------------------------------------------------------------
#  MIME types (modern formats older Apache installs may not know yet)
# -----------------------------------------------------------------------------
<IfModule mod_mime.c>
	AddType font/woff2              .woff2
	AddType font/woff               .woff
	AddType image/webp             .webp
	AddType image/avif             .avif
	AddType image/svg+xml          .svg
	AddType application/rss+xml    .xml
	AddType application/manifest+json .webmanifest
</IfModule>

# -----------------------------------------------------------------------------
#  Compression
# -----------------------------------------------------------------------------
<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
	AddOutputFilterByType DEFLATE application/javascript application/json
	AddOutputFilterByType DEFLATE application/xml application/rss+xml
	AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# -----------------------------------------------------------------------------
#  Caching
#  - Hashed build assets under /_astro are safe to cache "forever".
#  - Other images/fonts get a shorter cache so updates still propagate.
#  - HTML is revalidated so content changes show up immediately.
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
	# Hashed assets: filename changes on every build -> immutable.
	<FilesMatch "\.[A-Za-z0-9_-]{8,}\.(css|js|woff2)$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>

	# Images and fonts (not content-hashed).
	<FilesMatch "\.(ico|png|jpe?g|gif|svg|webp|avif|woff2?)$">
		Header set Cache-Control "public, max-age=2592000"
	</FilesMatch>

	# HTML: always revalidate.
	<FilesMatch "\.html$">
		Header set Cache-Control "public, max-age=0, must-revalidate"
	</FilesMatch>

	# Feeds / sitemap: refresh regularly.
	<FilesMatch "\.(xml|txt)$">
		Header set Cache-Control "public, max-age=3600"
	</FilesMatch>
</IfModule>

# -----------------------------------------------------------------------------
#  Security headers
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
	Header always set X-Content-Type-Options "nosniff"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set X-Frame-Options "SAMEORIGIN"
	Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
	Header always set Cross-Origin-Opener-Policy "same-origin"
	Header unset X-Powered-By

	# Content Security Policy. Everything (fonts, styles, scripts, images)
	# is self-hosted. 'unsafe-inline' for styles is required because Astro
	# inlines the @font-face declarations. If you later add third-party
	# scripts (analytics, chat), extend script-src/connect-src accordingly.
	Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>

# -----------------------------------------------------------------------------
#  Hide dotfiles (keeps .git, .env, etc. private) while allowing .well-known
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
	RewriteRule "(^|/)\.(?!well-known/)" - [F]
</IfModule>
