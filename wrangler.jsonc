{
	"$schema": "https://developers.cloudflare.com/workers/wrangler/configuration/schema.json",
	"name": "wfrlee-blog",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./dist/_worker.js/index.js",
	"assets": {
		"directory": "./dist"
	},
	"build": {
		"command": "npm run build"
	}
}
