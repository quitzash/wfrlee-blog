{
	"$schema": "https://developers.cloudflare.com/workers/wrangler/configuration/schema.json",
	"name": "wfrlee-blog",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"pages_build_output_dir": "./dist"
	// NOTE: Cron Triggers are a Workers-only feature. Cloudflare Pages rejects
	// the `triggers` key outright ("Configuration file for Pages projects does
	// not support \"triggers\""), so the scheduled jobs are driven from
	// .github/workflows/weekly-cron.yml instead. It calls the same HTTP
	// endpoints with `Authorization: Bearer <CRON_SECRET>`.
}
