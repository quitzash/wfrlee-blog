# AI
ANTHROPIC_API_KEY=
# Optional: required only when the API key is not scoped to a workspace. Sent as
# the anthropic-workspace-id header on every request.
ANTHROPIC_WORKSPACE_ID=
# Model used to generate guides. Sonnet 5.5 is the default; Haiku is the
# fast/cheap option, Opus the most capable (and most expensive).
CLAUDE_MODEL=claude-sonnet-5-5
# Model used for the newsletter email JSON (a fast/cheap model is enough).
CLAUDE_FAST_MODEL=claude-haiku-5-5
# Optional: additional models to try (comma-separated) when the primary returns
# 429/500/529. Defaults to claude-sonnet-5-5, claude-sonnet-5, claude-haiku-5-5,
# claude-sonnet-4-6.
CLAUDE_FALLBACK_MODELS=

# Email (Resend recommended)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="Wfrlee.com <info@wfrlee.com>"
EMAIL_REPLY_TO="info@wfrlee.com"
# Resend segment (formerly "audience") that footer signups are stored in and
# that the newsletter send reads from.
RESEND_SEGMENT_NAME=wfrlee-newsletter
# Dev-only override: when set, /api/newsletter/send emails ONLY these addresses
# instead of the live subscriber list. Comma-separated.
MANUAL_TEST_EMAILS=
# Secret shared with the scheduler so the weekly jobs can run unattended.
# The scheduler sends it as `Authorization: Bearer <CRON_SECRET>`
# (see src/lib/auth.ts → isCronRequest).
CRON_SECRET=

# Weekly AI blog posts.
# The schedule lives in
# .github/workflows/weekly-cron.yml (Mondays 07:00 UTC). It calls this endpoint
# once per language with `?lang=en` / `?lang=ar`.
# Vercel: the two entries in vercel.json, told apart by the
# x-vercel-cron-schedule header, so English and Arabic are generated
# separately (each stays within the 60s serverless limit).
# Every Monday the job researches high-ranking, trending and high-visibility
# keywords (Google Suggest + a local on-brand scorer), picks the best, and
# publishes a guide via GitHub.
# Trigger both manually from /admin ("Publish this week's post" → Both), or
# override a single run with ?lang=en or ?lang=ar.
# Requires ANTHROPIC_API_KEY, GITHUB_TOKEN, GITHUB_REPO and CRON_SECRET (for the
# unattended cron) to be set.

# Publishing (GitHub) to publish AI-generated guides
# GITHUB_TOKEN: fine-grained PAT with Contents: read+write, or classic with repo scope
# GITHUB_REPO: "owner/repo" of the repo to commit into (Vercel must import the SAME repo)
GITHUB_TOKEN=
GITHUB_REPO=
# Leave empty to auto-use the repo's default branch (recommended). If set, it is
# used only as an override when the default branch is not the publish target.
GITHUB_BRANCH=master
GITHUB_COMMITTER_NAME="Wfrlee AI"
GITHUB_COMMITTER_EMAIL="info@wfrlee.com"

# Admin
# Shared admin token used to log into /admin (AI Content Studio). Keep it long,
# random, and stored only in the server environment — never commit it.
ADMIN_TOKEN=

# Optional: separate secret for signing admin session cookies. Leave unset to
# derive it from ADMIN_TOKEN.
ADMIN_SESSION_SECRET=
