---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { serverEnv } from '@/lib/env';
import { ADMIN_CSP, SESSION_COOKIE, verifyAdminSession } from '@/lib/auth';

const authed = verifyAdminSession(Astro.cookies.get(SESSION_COOKIE)?.value ?? null);

Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, max-age=0');
Astro.response.headers.set('X-Content-Type-Options', 'nosniff');
Astro.response.headers.set('X-Frame-Options', 'DENY');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
Astro.response.headers.set('Permissions-Policy', 'geolocation=(), microphone=(), camera=()');
Astro.response.headers.set('Cross-Origin-Opener-Policy', 'same-origin');
Astro.response.headers.set('Content-Security-Policy', ADMIN_CSP);

const adminTokenConfigured = Boolean(serverEnv('ADMIN_TOKEN'));
const geminiConfigured = Boolean(serverEnv('GEMINI_API_KEY'));
const githubConfigured = Boolean(serverEnv('GITHUB_TOKEN') && serverEnv('GITHUB_REPO'));
const checks = [
	{ label: 'ADMIN_TOKEN', ok: adminTokenConfigured },
	{ label: 'GEMINI_API_KEY', ok: geminiConfigured },
	{ label: 'GITHUB_TOKEN + GITHUB_REPO', ok: githubConfigured },
];
---

<BaseLayout lang="en" title="AI Content Studio" noindex>
	<section class="border-b border-slate-200 bg-slate-50">
		<div class="container-page py-10">
			<p class="text-xs font-semibold uppercase tracking-wide text-brand-600">Wfrlee internal tool</p>
			<h1 class="mt-2 text-3xl font-bold text-slate-900">AI Content Studio</h1>
			<p class="mt-2 max-w-2xl text-slate-600">
				Generate SEO guides with Gemini and publish them live to the blog via GitHub. Each post is committed to
				the repo, which triggers a Vercel rebuild that puts it on the site. This page is not indexed and is not
				linked from the public site.
			</p>
		</div>
	</section>

	{
		authed ? (
			<>
			<section class="container-page py-10">
				<div class="mx-auto mb-8 max-w-2xl rounded-lg border border-slate-200 bg-white p-4 text-sm">
					<p class="font-semibold text-slate-900">Server configuration (live)</p>
					<ul class="mt-2 space-y-1">
						{
							checks.map((check) => (
								<li class="flex items-center gap-2">
									<span class={check.ok ? 'text-emerald-600' : 'text-red-600'}>
										{check.ok ? '✓ configured' : '✗ MISSING'}
									</span>
									<span class="font-mono text-xs text-slate-600">{check.label}</span>
								</li>
							))
						}
					</ul>
					<p class="mt-2 text-xs text-slate-500">
						This reflects the values Vercel passes to the running deployment. Any “MISSING” entry must be
						added in Vercel → Settings → Environment Variables, then redeployed.
					</p>
				</div>

				<form id="generate-form" class="mx-auto max-w-2xl space-y-6">
					<div class="grid gap-4 sm:grid-cols-2">
						<div>
							<label for="lang" class="block text-sm font-semibold text-slate-900">Language</label>
							<select
								id="lang"
								name="lang"
								class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-200"
							>
								<option value="en">English (en)</option>
								<option value="ar">العربية (ar)</option>
							</select>
						</div>
						<div>
							<label for="city" class="block text-sm font-semibold text-slate-900">
								City <span class="font-normal text-slate-500">(optional)</span>
							</label>
							<input
								id="city"
								name="city"
								type="text"
								class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-200"
								placeholder="Jeddah"
							/>
						</div>
					</div>

					<div>
						<div class="flex items-center justify-between">
							<label for="topic" class="block text-sm font-semibold text-slate-900">Topic</label>
							<div class="flex items-center gap-2">
								<button
									type="button"
									id="refill-btn"
									class="inline-flex items-center rounded-md border border-slate-200 bg-white px-2.5 py-1 text-xs font-semibold text-slate-600 transition-colors hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-200 disabled:cursor-not-allowed disabled:opacity-50"
								>
									Refill last
								</button>
								<button
									type="button"
									id="random-btn"
									class="inline-flex items-center rounded-md border border-brand-200 bg-brand-50 px-2.5 py-1 text-xs font-semibold text-brand-700 transition-colors hover:bg-brand-100 focus:outline-none focus:ring-2 focus:ring-brand-200"
								>
									Random topic &amp; keywords
								</button>
							</div>
						</div>
						<input
							id="topic"
							name="topic"
							type="text"
							required
							maxlength="80"
							class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-200"
							placeholder="Jeddah airport layover guide"
						/>
						<p class="mt-1 text-xs text-slate-500">
							Fills Topic, Primary keyword and Tags with an on-brand Wfrlee idea (layovers, micro-stays,
							hourly bookings). Keep clicking for another idea.
						</p>
					</div>

					<div>
						<label for="primaryKeyword" class="block text-sm font-semibold text-slate-900">
							Primary keyword
						</label>
						<input
							id="primaryKeyword"
							name="primaryKeyword"
							type="text"
							required
							maxlength="80"
							class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-200"
							placeholder="jeddah airport layover"
						/>
					</div>

					<div>
						<label for="tags" class="block text-sm font-semibold text-slate-900">
							Tags <span class="font-normal text-slate-500">(comma separated, optional)</span>
						</label>
						<input
							id="tags"
							name="tags"
							type="text"
							class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-200"
							placeholder="layover, jeddah, micro-stay"
						/>
					</div>

					<label class="flex items-center gap-2 text-sm text-slate-700">
						<input
							type="checkbox"
							name="includeFaq"
							checked
							class="h-4 w-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500"
						/>
						Include FAQ section (Schema.org FAQPage)
					</label>

					<div class="flex items-center gap-4">
						<button
							type="submit"
							id="submit-btn"
							class="inline-flex items-center rounded-lg bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-700 disabled:cursor-not-allowed disabled:opacity-60"
						>
							Generate &amp; publish
						</button>
						<button
							type="button"
							id="logout-btn"
							class="text-sm font-medium text-slate-500 hover:text-slate-700"
						>
							Log out
						</button>
					</div>
				</form>

				<div
					id="result"
					role="status"
					aria-live="polite"
					class="mx-auto mt-8 hidden max-w-2xl rounded-lg border p-4 text-sm"
				>
				</div>
			</section>

			<section class="border-t border-slate-200 bg-slate-50">
				<div class="container-page py-10">
					<div class="mx-auto max-w-3xl">
						<div class="flex flex-wrap items-start justify-between gap-3">
							<div>
								<h2 class="text-2xl font-bold text-slate-900">Manage posts</h2>
								<p class="mt-1 text-sm text-slate-600">
									Edit, save, or delete published posts. Every change is committed to GitHub and triggers a
									Vercel rebuild.
								</p>
							</div>
							<div class="flex items-center gap-2">
								<select
									id="manage-lang"
									class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-200"
								>
									<option value="en">English</option>
									<option value="ar">العربية</option>
								</select>
								<button
									type="button"
									id="manage-refresh"
									class="inline-flex items-center rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-200"
								>
									Refresh
								</button>
							</div>
						</div>

						<div
							id="manage-status"
							role="status"
							aria-live="polite"
							class="mt-4 hidden rounded-lg border p-3 text-sm"
						>
						</div>

						<ul
							id="manage-list"
							class="mt-4 divide-y divide-slate-200 overflow-hidden rounded-lg border border-slate-200 bg-white"
						>
						</ul>

						<div id="manage-editor" class="mt-6 hidden rounded-lg border border-slate-200 bg-white p-5">
							<div class="mb-4 flex items-start justify-between gap-3">
								<div class="min-w-0">
									<p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Editing</p>
									<p id="manage-path" class="break-all font-mono text-xs text-slate-600"></p>
								</div>
								<button
									type="button"
									id="manage-close"
									class="shrink-0 text-sm font-medium text-slate-500 hover:text-slate-700"
								>
									Close
								</button>
							</div>

							<form id="manage-form" class="space-y-4">
								<div>
									<label for="m-title" class="block text-sm font-semibold text-slate-900">Title</label>
									<input
										id="m-title"
										type="text"
										class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-200"
									/>
								</div>

								<div>
									<label for="m-description" class="block text-sm font-semibold text-slate-900">Description</label>
									<textarea
										id="m-description"
										rows="3"
										class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-200"
									></textarea>
								</div>

								<div class="grid gap-4 sm:grid-cols-2">
									<div>
										<label for="m-category" class="block text-sm font-semibold text-slate-900">Category</label>
										<input
											id="m-category"
											type="text"
											class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-200"
										/>
									</div>
									<div>
										<label for="m-city" class="block text-sm font-semibold text-slate-900">City</label>
										<input
											id="m-city"
											type="text"
											class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-200"
										/>
									</div>
								</div>

								<div class="grid gap-4 sm:grid-cols-2">
									<div>
										<label for="m-primaryKeyword" class="block text-sm font-semibold text-slate-900">
											Primary keyword
										</label>
										<input
											id="m-primaryKeyword"
											type="text"
											class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-200"
										/>
									</div>
									<div>
										<label for="m-pubDate" class="block text-sm font-semibold text-slate-900">Publish date</label>
										<input
											id="m-pubDate"
											type="text"
											placeholder="2026-01-01"
											class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-200"
										/>
									</div>
								</div>

								<div>
									<label for="m-tags" class="block text-sm font-semibold text-slate-900">
										Tags <span class="font-normal text-slate-500">(comma separated)</span>
									</label>
									<input
										id="m-tags"
										type="text"
										class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-200"
									/>
								</div>

								<label class="flex items-center gap-2 text-sm text-slate-700">
									<input
										type="checkbox"
										id="m-draft"
										class="h-4 w-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500"
									/>
									Draft (hidden from the site)
								</label>

								<div>
									<label for="m-body" class="block text-sm font-semibold text-slate-900">
										Body <span class="font-normal text-slate-500">(Markdown)</span>
									</label>
									<textarea
										id="m-body"
										rows="18"
										class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 font-mono text-xs shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-200"
									></textarea>
								</div>

								<div class="flex flex-wrap items-center gap-3">
									<button
										type="submit"
										id="manage-save"
										class="inline-flex items-center rounded-lg bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-700 disabled:cursor-not-allowed disabled:opacity-60"
									>
										Save
									</button>
									<button
										type="button"
										id="manage-delete"
										class="inline-flex items-center rounded-lg border border-red-200 bg-white px-5 py-2.5 text-sm font-semibold text-red-700 transition-colors hover:bg-red-50"
									>
										Delete
									</button>
									<span id="manage-editor-status" class="text-sm text-slate-500"></span>
								</div>
							</form>
						</div>
					</div>
				</div>
			</section>
			</>
		) : (
			<section class="container-page py-10">
				{
					!adminTokenConfigured ? (
						<div class="mx-auto max-w-md rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-800">
							<strong>This deployment has no ADMIN_TOKEN set.</strong>
							<br />
							Add it in Vercel → Settings → Environment Variables (Production), save, and redeploy —
							the admin login cannot work until the server has a token configured.
						</div>
					) : null
				}
				<form id="login-form" class="mx-auto max-w-md space-y-4 rounded-lg border border-slate-200 bg-white p-6">
					<div>
						<label for="login-token" class="block text-sm font-semibold text-slate-900">Admin token</label>
						<input
							id="login-token"
							name="token"
							type="password"
							autocomplete="off"
							required
							class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-200"
							placeholder="ADMIN_TOKEN"
						/>
						<p class="mt-1 text-xs text-slate-500">
							The token is verified on the server and exchanged for a short-lived session. It never
							reaches the page as plain text.
						</p>
					</div>
					<button
						type="submit"
						id="login-btn"
						class="inline-flex w-full items-center justify-center rounded-lg bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-700 disabled:cursor-not-allowed disabled:opacity-60"
					>
						Log in
					</button>
					<div id="login-error" role="alert" class="hidden rounded-md bg-red-50 p-3 text-sm text-red-700">
					</div>
				</form>
			</section>
		)
	}

	<div id="admin-root" data-authed={authed ? 'true' : 'false'} class="hidden"></div>
</BaseLayout>

<script>
	const authed = document.getElementById('admin-root')?.dataset.authed === 'true';

	if (authed) {
		const form = document.getElementById('generate-form') as HTMLFormElement | null;
		const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
		const logoutBtn = document.getElementById('logout-btn');
		const result = document.getElementById('result');

		logoutBtn?.addEventListener('click', async () => {
			await fetch('/api/admin/logout', { method: 'POST' });
			window.location.reload();
		});

		// ---- Random topic & keyword generator -----------------------------------
		// On-brand combinations for Wfrlee.com: hourly micro-stays, layovers and
		// short bookings across Saudi Arabia and the Gulf. Pure client-side so it
		// is instant and never depends on the Gemini key.
		const topicInput = document.getElementById('topic') as HTMLInputElement | null;
		const keywordInput = document.getElementById('primaryKeyword') as HTMLInputElement | null;
		const tagsInput = document.getElementById('tags') as HTMLInputElement | null;
		const cityInput = document.getElementById('city') as HTMLInputElement | null;
		const randomBtn = document.getElementById('random-btn') as HTMLButtonElement | null;
		const refillBtn = document.getElementById('refill-btn') as HTMLButtonElement | null;

		const stayCities = [
			{ name: 'Jeddah', area: 'Jeddah airport' },
			{ name: 'Riyadh', area: 'Riyadh airport' },
			{ name: 'Dammam', area: 'Dammam airport' },
			{ name: 'Makkah', area: 'the Haram' },
			{ name: 'Madinah', area: 'Madinah airport' },
			{ name: 'Abha', area: 'Abha airport' },
			{ name: 'Dubai', area: 'Dubai airport' },
			{ name: 'Abu Dhabi', area: 'Abu Dhabi airport' },
			{ name: 'Doha', area: 'Doha airport' },
			{ name: 'Kuwait City', area: 'Kuwait airport' },
			{ name: 'Manama', area: 'Bahrain airport' },
			{ name: 'Muscat', area: 'Muscat airport' },
			{ name: 'Amman', area: 'Amman airport' },
			{ name: 'Cairo', area: 'Cairo airport' },
		];

		const stayStyles = [
			{ label: 'hourly micro-stay', keyword: 'micro-stay', tag: 'micro-stays' },
			{ label: 'hourly hotel', keyword: 'hourly hotel', tag: 'hourly hotels' },
			{ label: 'day-use room', keyword: 'day-use room', tag: 'day-use rooms' },
			{ label: 'layover stay', keyword: 'layover hotel', tag: 'layover' },
			{ label: 'stopover stay', keyword: 'stopover hotel', tag: 'stopover' },
			{ label: 'short stay', keyword: 'short stay', tag: 'short stays' },
			{ label: 'airport rest stop', keyword: 'airport hotel', tag: 'airport hotel' },
			{ label: 'last-minute booking', keyword: 'last-minute hotel', tag: 'last-minute booking' },
			{ label: 'work-friendly stay', keyword: 'work-friendly hotel', tag: 'business travel' },
			{ label: 'family layover stay', keyword: 'family-friendly hotel', tag: 'family travel' },
			{ label: 'budget micro-stay', keyword: 'budget hourly hotel', tag: 'budget travel' },
		];

		type City = { name: string; area: string };
		type Style = { label: string; keyword: string; tag: string };

		// "an hourly hotel" / "an airport rest stop" but "a short stay".
		const article = (word: string): string => (/^([aeiou]|hour)/i.test(word) ? 'an' : 'a');

		const topicPatterns: Array<(city: City, style: Style) => string> = [
			(city, style) => `${city.name} ${style.label} guide for travelers`,
			(city, style) => `How to book ${article(style.label)} ${style.label} in ${city.name}`,
			(city, style) => `Best ${style.label} options in ${city.name}`,
			(city, style) => `${city.name} ${style.label} tips: a traveler's checklist`,
			(city, style) => `Why ${article(style.label)} ${style.label} in ${city.name} beats a full-day hotel`,
			(city, style) => `${city.name} Wfrlee.com guide: book ${article(style.label)} ${style.label} by the hour`,
			(city, style) => `Booking ${article(style.label)} ${style.label} in ${city.name} with Wfrlee.com`,
			(city, style) => `${city.name} layover guide: ${style.label} essentials`,
			(city) => `${city.name} stopover: how to rest between flights`,
			(city, style) => `Where to sleep in ${city.name}: ${style.label} picks`,
		];

		const keywordPatterns: Array<(city: City, style: Style) => string> = [
			(city, style) => `${city.name} ${style.keyword}`,
			(city, style) => `${style.keyword} ${city.name}`,
			(city, style) => `book ${style.keyword} in ${city.name}`,
			(city, style) => `${style.keyword} near ${city.area}`,
			(city, style) => `wfrlee.com ${city.name} ${style.keyword}`,
		];

		const pick = <T,>(items: T[]): T => items[Math.floor(Math.random() * items.length)];

		function randomizeTopic() {
			const city = pick(stayCities);
			const style = pick(stayStyles);
			const topic = pick(topicPatterns)(city, style).slice(0, 80);
			const keyword = pick(keywordPatterns)(city, style).toLowerCase().slice(0, 80);
			const tags = Array.from(new Set([city.name, style.tag, 'wfrlee.com', 'booking'])).join(', ');

			if (topicInput) topicInput.value = topic;
			if (keywordInput) keywordInput.value = keyword;
			if (tagsInput) tagsInput.value = tags;
			if (cityInput) cityInput.value = city.name;
		}

		randomBtn?.addEventListener('click', randomizeTopic);

		// ---- "Refill last" ------------------------------------------------------
		// Remembers the last brief that was actually submitted (topic, primary
		// keyword, tags, city) so it can be restored after a reset or a page reload.
		type LastBrief = { topic: string; primaryKeyword: string; tags: string; city: string };
		const LAST_BRIEF_KEY = 'wfrlee:last-brief';

		function readLastBrief(): LastBrief | null {
			try {
				const raw = localStorage.getItem(LAST_BRIEF_KEY);
				if (!raw) return null;
				const parsed = JSON.parse(raw) as Partial<LastBrief>;
				if (!parsed.topic && !parsed.primaryKeyword && !parsed.tags) return null;
				return {
					topic: parsed.topic ?? '',
					primaryKeyword: parsed.primaryKeyword ?? '',
					tags: parsed.tags ?? '',
					city: parsed.city ?? '',
				};
			} catch {
				return null;
			}
		}

		function saveLastBrief(brief: LastBrief) {
			try {
				localStorage.setItem(LAST_BRIEF_KEY, JSON.stringify(brief));
			} catch {
				// Storage unavailable (private mode / disabled) — refill just won't persist.
			}
			syncRefillButton();
		}

		function syncRefillButton() {
			if (refillBtn) refillBtn.disabled = readLastBrief() === null;
		}

		function refillLastBrief() {
			const brief = readLastBrief();
			if (!brief) return;
			if (topicInput) topicInput.value = brief.topic;
			if (keywordInput) keywordInput.value = brief.primaryKeyword;
			if (tagsInput) tagsInput.value = brief.tags;
			if (cityInput) cityInput.value = brief.city;
		}

		refillBtn?.addEventListener('click', refillLastBrief);
		syncRefillButton();

		// ---- Manage posts: edit / save / delete --------------------------------
		// Reads straight from GitHub (the source of truth), so a saved edit is
		// visible here immediately — even before Vercel finishes rebuilding.
		const manageLangSel = document.getElementById('manage-lang') as HTMLSelectElement | null;
		const manageRefreshBtn = document.getElementById('manage-refresh') as HTMLButtonElement | null;
		const manageList = document.getElementById('manage-list') as HTMLUListElement | null;
		const manageStatus = document.getElementById('manage-status');
		const manageEditor = document.getElementById('manage-editor');
		const managePathLabel = document.getElementById('manage-path');
		const manageForm = document.getElementById('manage-form') as HTMLFormElement | null;
		const manageSaveBtn = document.getElementById('manage-save') as HTMLButtonElement | null;
		const manageDeleteBtn = document.getElementById('manage-delete') as HTMLButtonElement | null;
		const manageCloseBtn = document.getElementById('manage-close');
		const manageEditorStatus = document.getElementById('manage-editor-status');

		const mTitle = document.getElementById('m-title') as HTMLInputElement | null;
		const mDescription = document.getElementById('m-description') as HTMLTextAreaElement | null;
		const mCategory = document.getElementById('m-category') as HTMLInputElement | null;
		const mCity = document.getElementById('m-city') as HTMLInputElement | null;
		const mTags = document.getElementById('m-tags') as HTMLInputElement | null;
		const mKeyword = document.getElementById('m-primaryKeyword') as HTMLInputElement | null;
		const mPubDate = document.getElementById('m-pubDate') as HTMLInputElement | null;
		const mDraft = document.getElementById('m-draft') as HTMLInputElement | null;
		const mBody = document.getElementById('m-body') as HTMLTextAreaElement | null;

		let editingPath: string | null = null;
		let editingFrontmatter = '';

		function setManageStatus(kind: 'info' | 'ok' | 'error', message: string) {
			if (!manageStatus) return;
			const tone =
				kind === 'ok'
					? 'border-emerald-200 bg-emerald-50 text-emerald-800'
					: kind === 'error'
						? 'border-red-200 bg-red-50 text-red-800'
						: 'border-slate-200 bg-white text-slate-600';
			manageStatus.className = `mt-4 rounded-lg border p-3 text-sm ${tone}`;
			manageStatus.textContent = message;
			manageStatus.classList.remove('hidden');
		}

		function esc(value: string): string {
			return value.replace(/\\/g, '\\\\').replace(/"/g, '\\"');
		}

		function splitFrontmatter(text: string): { raw: string; body: string } | null {
			const match = text.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n?([\s\S]*)$/);
			return match ? { raw: match[1], body: match[2] ?? '' } : null;
		}

		function fieldRaw(raw: string, key: string): string | undefined {
			const lines = raw.split(/\r?\n/);
			const index = lines.findIndex((line) => new RegExp(`^${key}\\s*:`).test(line.trim()));
			if (index === -1) return undefined;
			return lines[index].slice(lines[index].indexOf(':') + 1).trim();
		}

		function unquote(value: string): string {
			const match = value.match(/^(["'])([\s\S]*)\1$/);
			return match ? match[2] : value;
		}

		function fieldString(raw: string, key: string): string {
			const value = fieldRaw(raw, key);
			return value === undefined ? '' : unquote(value);
		}

		function fieldBool(raw: string, key: string): boolean {
			return /^true$/i.test(fieldRaw(raw, key) ?? '');
		}

		function fieldArray(raw: string, key: string): string[] {
			const value = fieldRaw(raw, key);
			if (!value) return [];
			const inner = value.replace(/^\[/, '').replace(/\]$/, '').trim();
			if (!inner) return [];
			return inner
				.split(',')
				.map((part) => unquote(part.trim()))
				.filter(Boolean);
		}

		function setField(raw: string, key: string, line: string): string {
			const lines = raw.split(/\r?\n/);
			const index = lines.findIndex((l) => new RegExp(`^${key}\\s*:`).test(l.trim()));
			if (index === -1) lines.push(line);
			else lines[index] = line;
			return lines.join('\n');
		}

		type PostSummary = {
			path: string;
			name: string;
			title?: string;
			city?: string;
			category?: string;
			pubDate?: string;
			draft?: boolean;
		};

		function renderPosts(posts: PostSummary[]) {
			if (!manageList) return;
			manageList.innerHTML = '';
			if (!posts.length) {
				const empty = document.createElement('li');
				empty.className = 'px-4 py-3 text-sm text-slate-500';
				empty.textContent = 'No posts found.';
				manageList.appendChild(empty);
				return;
			}
			for (const post of posts) {
				const li = document.createElement('li');
				const button = document.createElement('button');
				button.type = 'button';
				button.className = 'flex w-full items-center justify-between gap-3 px-4 py-3 text-left hover:bg-slate-50';

				const left = document.createElement('span');
				left.className = 'min-w-0';
				const title = document.createElement('span');
				title.className = 'block truncate text-sm font-semibold text-slate-900';
				title.textContent = post.title || post.name;
				const meta = document.createElement('span');
				meta.className = 'mt-0.5 block truncate text-xs text-slate-500';
				meta.textContent = [post.city, post.category, post.pubDate].filter(Boolean).join(' · ');
				left.appendChild(title);
				left.appendChild(meta);

				const right = document.createElement('span');
				right.className = 'shrink-0';
				if (post.draft) {
					const badge = document.createElement('span');
					badge.className = 'rounded-full bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-800';
					badge.textContent = 'Draft';
					right.appendChild(badge);
				}

				button.appendChild(left);
				button.appendChild(right);
				button.addEventListener('click', () => openEditor(post.path));
				li.appendChild(button);
				manageList.appendChild(li);
			}
		}

		async function loadPosts() {
			if (!manageLangSel) return;
			const lang = manageLangSel.value;
			setManageStatus('info', 'Loading posts…');
			try {
				const response = await fetch(`/api/admin/posts?lang=${encodeURIComponent(lang)}`);
				const json = await response.json().catch(() => ({}));
				if (response.status === 401) {
					setManageStatus('error', 'Session expired. Reload the page and log back in.');
					return;
				}
				if (!response.ok || !json.ok) throw new Error(json.error ?? 'Could not load posts.');
				renderPosts(json.posts ?? []);
				setManageStatus('ok', `${json.posts?.length ?? 0} post(s) in ${lang.toUpperCase()}.`);
			} catch (error) {
				setManageStatus('error', error instanceof Error ? error.message : 'Could not load posts.');
			}
		}

		function fillEditor(path: string, content: string) {
			const split = splitFrontmatter(content);
			if (!split) {
				setManageStatus('error', 'That file has no YAML frontmatter and cannot be edited here.');
				return;
			}
			editingPath = path;
			editingFrontmatter = split.raw;
			if (managePathLabel) managePathLabel.textContent = path;
			if (mTitle) mTitle.value = fieldString(split.raw, 'title');
			if (mDescription) mDescription.value = fieldString(split.raw, 'description');
			if (mCategory) mCategory.value = fieldString(split.raw, 'category');
			if (mCity) mCity.value = fieldString(split.raw, 'city');
			if (mKeyword) mKeyword.value = fieldString(split.raw, 'primaryKeyword');
			if (mPubDate) mPubDate.value = fieldString(split.raw, 'pubDate');
			if (mTags) mTags.value = fieldArray(split.raw, 'tags').join(', ');
			if (mDraft) mDraft.checked = fieldBool(split.raw, 'draft');
			if (mBody) mBody.value = split.body.replace(/^\n+/, '');
			if (manageEditorStatus) manageEditorStatus.textContent = '';
			manageEditor?.classList.remove('hidden');
			manageEditor?.scrollIntoView({ behavior: 'smooth', block: 'start' });
		}

		async function openEditor(path: string) {
			setManageStatus('info', `Opening ${path}…`);
			try {
				const response = await fetch(`/api/admin/posts?path=${encodeURIComponent(path)}`);
				const json = await response.json().catch(() => ({}));
				if (response.status === 401) {
					setManageStatus('error', 'Session expired. Reload the page and log back in.');
					return;
				}
				if (!response.ok || !json.ok) throw new Error(json.error ?? 'Could not open the file.');
				fillEditor(path, json.content);
				setManageStatus('ok', `Editing ${path}`);
			} catch (error) {
				setManageStatus('error', error instanceof Error ? error.message : 'Could not open the file.');
			}
		}

		function buildContent(): string {
			const today = new Date().toISOString().slice(0, 10);
			let raw = editingFrontmatter;
			raw = setField(raw, 'title', `title: "${esc(mTitle?.value.trim() ?? '')}"`);
			raw = setField(raw, 'description', `description: "${esc(mDescription?.value.trim() ?? '')}"`);
			raw = setField(raw, 'category', `category: "${esc(mCategory?.value.trim() ?? '')}"`);
			const cityValue = mCity?.value.trim() ?? '';
			if (cityValue) raw = setField(raw, 'city', `city: "${esc(cityValue)}"`);
			raw = setField(raw, 'primaryKeyword', `primaryKeyword: "${esc(mKeyword?.value.trim() ?? '')}"`);
			const tags = (mTags?.value ?? '')
				.split(',')
				.map((tag) => tag.trim())
				.filter(Boolean);
			raw = setField(raw, 'tags', `tags: [${tags.map((tag) => `"${esc(tag)}"`).join(', ')}]`);
			const pubDate = mPubDate?.value.trim() ?? '';
			if (pubDate) raw = setField(raw, 'pubDate', `pubDate: ${pubDate}`);
			raw = setField(raw, 'updatedDate', `updatedDate: ${today}`);
			raw = setField(raw, 'draft', `draft: ${mDraft?.checked ? 'true' : 'false'}`);
			const body = (mBody?.value ?? '').replace(/^\n+/, '').replace(/\s+$/, '');
			return `---\n${raw}\n---\n\n${body}\n`;
		}

		manageRefreshBtn?.addEventListener('click', loadPosts);
		manageLangSel?.addEventListener('change', loadPosts);
		manageCloseBtn?.addEventListener('click', () => {
			manageEditor?.classList.add('hidden');
			editingPath = null;
		});

		manageForm?.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (!editingPath || !manageSaveBtn) return;
			const content = buildContent();
			manageSaveBtn.disabled = true;
			if (manageEditorStatus) manageEditorStatus.textContent = 'Saving…';
			try {
				const response = await fetch('/api/admin/posts', {
					method: 'PUT',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({ path: editingPath, content }),
				});
				const json = await response.json().catch(() => ({}));
				if (response.status === 401) {
					if (manageEditorStatus) manageEditorStatus.textContent = 'Session expired.';
					return;
				}
				if (!response.ok || !json.ok) throw new Error(json.error ?? 'Save failed.');
				if (manageEditorStatus) {
					manageEditorStatus.textContent = `Saved · commit ${String(json.commitSha ?? '').slice(0, 7)}`;
				}
				setManageStatus('ok', `Saved ${editingPath} — Vercel is rebuilding.`);
				await loadPosts();
			} catch (error) {
				const message = error instanceof Error ? error.message : 'Save failed.';
				if (manageEditorStatus) manageEditorStatus.textContent = '';
				setManageStatus('error', message);
			} finally {
				manageSaveBtn.disabled = false;
			}
		});

		manageDeleteBtn?.addEventListener('click', async () => {
			if (!editingPath) return;
			if (!window.confirm(`Delete ${editingPath}? This commits a deletion and cannot be undone here.`)) return;
			try {
				const response = await fetch('/api/admin/posts', {
					method: 'DELETE',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({ path: editingPath }),
				});
				const json = await response.json().catch(() => ({}));
				if (response.status === 401) {
					setManageStatus('error', 'Session expired. Reload the page and log back in.');
					return;
				}
				if (!response.ok || !json.ok) throw new Error(json.error ?? 'Delete failed.');
				setManageStatus('ok', `Deleted ${editingPath} — Vercel is rebuilding.`);
				manageEditor?.classList.add('hidden');
				editingPath = null;
				await loadPosts();
			} catch (error) {
				setManageStatus('error', error instanceof Error ? error.message : 'Delete failed.');
			}
		});

		loadPosts();

		function showResult(kind: 'ok' | 'error', html: string) {
			if (!result) return;
			result.className =
				'mx-auto mt-8 max-w-2xl rounded-lg border p-4 text-sm ' +
				(kind === 'ok'
					? 'border-emerald-200 bg-emerald-50 text-emerald-800'
					: 'border-red-200 bg-red-50 text-red-800');
			result.innerHTML = html;
			result.classList.remove('hidden');
		}

		form?.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (!submitBtn) return;

			const data = new FormData(form);
			const tagsRaw = String(data.get('tags') ?? '').trim();
			const payload = {
				lang: String(data.get('lang') ?? 'en') as 'en' | 'ar',
				topic: String(data.get('topic') ?? '').trim(),
				city: String(data.get('city') ?? '').trim() || undefined,
				primaryKeyword: String(data.get('primaryKeyword') ?? '').trim(),
				tags: tagsRaw ? tagsRaw.split(',').map((tag) => tag.trim()).filter(Boolean) : undefined,
				includeFaq: data.get('includeFaq') === 'on',
			};

			saveLastBrief({ topic: payload.topic, primaryKeyword: payload.primaryKeyword, tags: tagsRaw, city: payload.city ?? '' });

			submitBtn.disabled = true;
			const originalLabel = submitBtn.textContent;
			submitBtn.textContent = 'Generating…';
			showResult('ok', 'Generating the guide and publishing it to the site…');

			try {
				const response = await fetch('/api/ai/generate-post', {
					method: 'POST',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify(payload),
				});
				const json = await response.json().catch(() => ({}));
				if (response.status === 401) {
					showResult(
						'error',
						'<strong>Session expired.</strong><br />Reload the page and log back in with the admin token, then retry.',
					);
					return;
				}
				if (!response.ok || !json.ok) {
					const stepLabel = json.step === 'publish' ? 'GitHub publish failed.' : json.step === 'generate' ? 'Generation failed.' : 'Request failed.';
					throw new Error(stepLabel + ' ' + (json.error ?? '(' + response.status + ')'));
				}
				showResult(
					'ok',
					'<strong>Published.</strong><br />File: <code class="rounded bg-white/60 px-1">' +
						json.path +
						'</code><br />Commit ' +
						String(json.commitSha ?? '').slice(0, 7) +
						' pushed to <code class="rounded bg-white/60 px-1">' +
						(json.branch ?? '') +
						'</code> — Vercel is rebuilding now; the post will appear on the blog in a minute or two.',
				);
				form.reset();
			} catch (error) {
				const message = error instanceof Error ? error.message : 'Unexpected error';
				showResult('error', '<strong>Generation failed.</strong><br />' + message);
			} finally {
				submitBtn.disabled = false;
				submitBtn.textContent = originalLabel;
			}
		});
	} else {
		const loginForm = document.getElementById('login-form') as HTMLFormElement | null;
		const loginBtn = document.getElementById('login-btn') as HTMLButtonElement | null;
		const loginError = document.getElementById('login-error');
		const tokenInput = document.getElementById('login-token') as HTMLInputElement | null;

		function showLoginError(message: string) {
			if (!loginError) return;
			loginError.textContent = message;
			loginError.classList.remove('hidden');
		}

		loginForm?.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (!loginBtn || !tokenInput) return;

			loginError?.classList.add('hidden');
			loginBtn.disabled = true;
			const originalLabel = loginBtn.textContent;
			loginBtn.textContent = 'Logging in…';

			try {
				const response = await fetch('/api/admin/login', {
					method: 'POST',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({ token: tokenInput.value.trim() }),
				});
				const json = await response.json().catch(() => ({}));
				if (response.status === 429) {
					showLoginError(json.error ?? 'Too many attempts. Try again later.');
					return;
				}
				if (response.status === 500) {
					// Server-side misconfiguration (e.g. ADMIN_TOKEN not set on the
					// deployment) — show the real reason instead of "invalid token".
					showLoginError(json.error ?? 'Server misconfigured. Check the ADMIN_TOKEN environment variable and redeploy.');
					return;
				}
				if (!response.ok) {
					showLoginError('Invalid or missing admin token. Check the value set in Vercel.');
					tokenInput.focus();
					tokenInput.select();
					loginBtn.classList.add('animate-pulse');
					return;
				}
				window.location.reload();
			} catch {
				showLoginError('Network error. Try again.');
			} finally {
				loginBtn.disabled = false;
				loginBtn.textContent = originalLabel;
			}
		});
	}
</script>