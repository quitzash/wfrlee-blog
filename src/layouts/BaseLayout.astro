---
import '@/styles/global.css';
import BaseHead from '@/components/seo/BaseHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import type { Locale } from '@/i18n/ui';

interface Props {
	lang: Locale;
	title: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article';
	canonicalURL?: URL | string;
	alternateUrl?: string;
	publishedTime?: Date;
	modifiedTime?: Date;
	author?: string;
	noindex?: boolean;
}

const {
	lang,
	title,
	description,
	image,
	type,
	canonicalURL,
	alternateUrl,
	publishedTime,
	modifiedTime,
	author,
	noindex,
} = Astro.props;

const dir = lang === 'ar' ? 'rtl' : 'ltr';
---

<!doctype html>
<html lang={lang} dir={dir}>
	<head>
		<BaseHead
			title={title}
			lang={lang}
			description={description}
			image={image}
			type={type}
			canonicalURL={canonicalURL}
			alternateUrl={alternateUrl}
			publishedTime={publishedTime}
			modifiedTime={modifiedTime}
			author={author}
			noindex={noindex}
		/>
	</head>
	<body class="flex min-h-screen flex-col bg-white">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-brand-600 focus:px-4 focus:py-2 focus:text-white"
		>
			{lang === 'ar' ? 'تخطَّ إلى المحتوى' : 'Skip to content'}
		</a>
		<Header lang={lang} alternateUrl={alternateUrl} />
		<main id="main" class="flex-1">
			<slot />
		</main>
		<Footer lang={lang} />
	</body>
</html>
