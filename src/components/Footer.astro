---
import { Image } from 'astro:assets';
import logo from '@/assets/wfrlee-logo.png';
import {
	APP_LINKS,
	BOOKING_URL,
	CONTACT_EMAIL,
	MAIN_SITE_LINKS,
	SITE_BRAND,
	SITE_BRAND_AR,
	SITE_TITLE,
	SITE_TITLE_AR,
	SOCIAL_LINKS,
} from '@/consts';
import { homeHref } from '@/lib/blog';
import { cities, citiesHref, cityHref } from '@/lib/cities';
import { pageHref } from '@/lib/pages';
import { useTranslations, type Locale } from '@/i18n/ui';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const destinations = cities.map((city) => ({
	href: cityHref(city, lang),
	label: city.name[lang],
}));

const company = [
	{ href: MAIN_SITE_LINKS.faq, label: t('footer.faq') },
	{ href: MAIN_SITE_LINKS.offers, label: t('footer.offers') },
	{ href: MAIN_SITE_LINKS.careers, label: t('footer.careers') },
	{ href: pageHref('about', lang), label: t('footer.aboutUs') },
	{ href: MAIN_SITE_LINKS.contact, label: t('footer.contactUs') },
	{ href: pageHref('why-wfrlee', lang), label: t('footer.why') },
	{ href: homeHref(lang), label: t('footer.wfrleeBlog') },
];

const otherLinks = [
	{ href: MAIN_SITE_LINKS.referral, label: t('footer.referral') },
	{ href: MAIN_SITE_LINKS.privacy, label: t('footer.privacyPolicy') },
	{ href: MAIN_SITE_LINKS.safety, label: t('footer.safety') },
	{ href: MAIN_SITE_LINKS.terms, label: t('footer.terms') },
	{ href: MAIN_SITE_LINKS.partner, label: t('footer.partner') },
];

const linkClass = 'text-sm text-brand-200 transition-colors hover:text-white';
const headingClass = 'text-sm font-semibold text-white';
const isExternal = (href: string) => /^https?:\/\//.test(href);
---

<footer class="mt-16 bg-brand-800 text-brand-100">
	<div class="border-b border-white/10">
		<div class="container-page flex flex-col items-start justify-between gap-4 py-8 sm:flex-row sm:items-center">
			<div>
				<p class="text-lg font-bold text-white">{t('footer.newsletterTitle')}</p>
				<p class="mt-1 text-sm text-brand-200">{t('footer.newsletterText')}</p>
			</div>
			<form
				class="w-full sm:w-auto"
				method="post"
				action="/api/newsletter/subscribe"
				aria-label={t('footer.newsletterTitle')}
				data-subscribe-form
			>
				<div class="flex flex-col gap-2 sm:flex-row">
					<label class="sr-only" for="footer-email">{t('footer.emailPlaceholder')}</label>
					<input
						id="footer-email"
						type="email"
						name="email"
						required
						autocomplete="email"
						maxlength="254"
						placeholder={t('footer.emailPlaceholder')}
						class="w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-sm text-white placeholder:text-brand-200 focus:border-white focus:outline-none sm:w-64"
					/>
					<button
						type="submit"
						data-subscribe-btn
						class="flex-none rounded-lg bg-white px-4 py-2 text-sm font-semibold text-brand-800 transition-colors hover:bg-brand-50 disabled:cursor-not-allowed disabled:opacity-60"
					>
						{t('footer.subscribe')}
					</button>
				</div>
				<p
					data-subscribe-status
					aria-live="polite"
					class="mt-2 text-xs text-brand-300"
				>
					{t('footer.newsletterNote')}
				</p>
			</form>
		</div>
	</div>

	<div class="container-page grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-12">
		<div class="lg:col-span-4">
			<a href={homeHref(lang)} class="flex items-center gap-2.5">
				<span class="flex h-10 w-10 flex-none items-center justify-center rounded-lg bg-white p-1">
					<Image
						src={logo}
						alt="Wfrlee logo"
						width={32}
						height={32}
						class="h-full w-full object-contain"
					/>
				</span>
				<span class="flex flex-col leading-tight">
					{
						lang === 'ar' ? (
							<span lang="ar" dir="rtl" class="text-lg font-bold tracking-tight text-white">
								{SITE_BRAND_AR}
							</span>
						) : (
							<span class="text-lg font-bold tracking-tight text-white">
								Wfrlee<span class="text-brand-200">.com</span>
							</span>
						)
					}
				</span>
			</a>
			<p class="mt-4 max-w-sm text-sm leading-relaxed text-brand-200">{t('footer.tagline')}</p>

			<div class="mt-6">
				<h2 class={headingClass}>{t('footer.talkToUs')}</h2>
				<ul class="mt-3 space-y-2">
					<li>
						<a href={`mailto:${CONTACT_EMAIL}`} class={linkClass}>{CONTACT_EMAIL}</a>
					</li>
					<li>
						<a
							href={BOOKING_URL}
							target="_blank"
							rel="noopener noreferrer"
							class="text-sm font-semibold text-white hover:text-brand-100"
						>
							{t('footer.book')}
						</a>
					</li>
				</ul>
			</div>

			<div class="mt-6">
				<h2 class={headingClass}>{t('footer.getApp')}</h2>
				<div class="mt-3 flex flex-wrap gap-2">
					<a
						href={APP_LINKS.ios}
						target="_blank"
						rel="noopener noreferrer"
						class="rounded-lg border border-white/20 px-3 py-1.5 text-sm font-medium text-white transition-colors hover:bg-white/10"
					>
						{t('footer.appIos')}
					</a>
					<a
						href={APP_LINKS.android}
						target="_blank"
						rel="noopener noreferrer"
						class="rounded-lg border border-white/20 px-3 py-1.5 text-sm font-medium text-white transition-colors hover:bg-white/10"
					>
						{t('footer.appAndroid')}
					</a>
				</div>
			</div>

			<div class="mt-6 flex flex-wrap gap-3">
				{
					SOCIAL_LINKS.map((social) => (
						<a
							href={social.href}
							target="_blank"
							rel="noopener noreferrer"
							class="text-sm font-medium text-brand-200 hover:text-white"
						>
							{social.label}
						</a>
					))
				}
			</div>
		</div>

		<nav aria-label={t('footer.destinations')} class="lg:col-span-2">
			<h2 class={headingClass}>{t('footer.destinations')}</h2>
			<ul class="mt-4 space-y-2">
				{destinations.map((item) => (
					<li>
						<a href={item.href} class={linkClass}>{item.label}</a>
					</li>
				))}
				<li>
					<a href={citiesHref(lang)} class={linkClass}>{t('cities.back')}</a>
				</li>
			</ul>
		</nav>

		<nav aria-label={t('footer.company')} class="lg:col-span-3">
			<h2 class={headingClass}>{t('footer.company')}</h2>
			<ul class="mt-4 space-y-2">
				{company.map((item) => (
					<li>
						<a
							href={item.href}
							target={isExternal(item.href) ? '_blank' : undefined}
							rel={isExternal(item.href) ? 'noopener noreferrer' : undefined}
							class={linkClass}
						>
							{item.label}
						</a>
					</li>
				))}
			</ul>
		</nav>

		<nav aria-label={t('footer.otherLinks')} class="lg:col-span-3">
			<h2 class={headingClass}>{t('footer.otherLinks')}</h2>
			<ul class="mt-4 space-y-2">
				{otherLinks.map((item) => (
					<li>
						<a
							href={item.href}
							target={isExternal(item.href) ? '_blank' : undefined}
							rel={isExternal(item.href) ? 'noopener noreferrer' : undefined}
							class={linkClass}
						>
							{item.label}
						</a>
					</li>
				))}
			</ul>
		</nav>
	</div>

	<div class="border-t border-white/10">
		<div class="container-page flex flex-col items-center justify-between gap-2 py-6 text-xs text-brand-300 sm:flex-row">
			<p>
				© {year} {lang === 'ar' ? `${SITE_BRAND_AR} — ${SITE_TITLE_AR}` : `${SITE_BRAND} — ${SITE_TITLE}`}. {t('footer.rights')}
			</p>
			<p>{t('footer.tagline')}</p>
		</div>
	</div>
</footer>

<script>
	const form = document.querySelector('[data-subscribe-form]') as HTMLFormElement | null;
	const btn = document.querySelector('[data-subscribe-btn]') as HTMLButtonElement | null;
	const status = document.querySelector('[data-subscribe-status]') as HTMLParagraphElement | null;

	const isAr = document.documentElement.lang === 'ar';
	const messages: Record<'ok' | 'invalid' | 'fail', string> = isAr
		? { ok: 'شكرًا! تم الاشتراك بنجاح.', invalid: 'يرجى إدخال بريد إلكتروني صالح.', fail: 'حدث خطأ. حاول مرة أخرى لاحقًا.' }
		: { ok: "Thanks! You're on the list.", invalid: 'Please enter a valid email address.', fail: 'Something went wrong. Please try again later.' };

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!btn || !status) return;
		const emailInput = form.elements.namedItem('email') as HTMLInputElement | null;
		const value = (emailInput?.value ?? '').trim();
		if (!value || !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(value)) {
			status.textContent = messages.invalid;
			status.classList.remove('text-brand-300');
			status.classList.add('text-brand-50');
			return;
		}

		btn.disabled = true;
		const original = btn.textContent;
		btn.textContent = isAr ? 'جاري الاشتراك…' : 'Subscribing…';

		try {
			const response = await fetch('/api/newsletter/subscribe', {
				method: 'POST',
				headers: { 'content-type': 'application/json' },
				body: JSON.stringify({ email: value, lang: isAr ? 'ar' : 'en' }),
			});
			const json = await response.json().catch(() => ({}));
			if (response.ok && json.ok) {
				status.textContent = messages.ok;
				status.classList.remove('text-brand-300');
				status.classList.add('text-brand-50');
				if (emailInput) emailInput.value = '';
			} else {
				status.textContent = (json as { error?: string }).error === 'invalid_email' ? messages.invalid : messages.fail;
				status.classList.remove('text-brand-300');
				status.classList.add('text-brand-50');
			}
		} catch {
			status.textContent = messages.fail;
			status.classList.remove('text-brand-300');
			status.classList.add('text-brand-50');
		} finally {
			btn.disabled = false;
			btn.textContent = original;
		}
	});
</script>
