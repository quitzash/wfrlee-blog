---
import { Image } from 'astro:assets';
import logo from '@/assets/wfrlee-logo.png';
import { BOOKING_URL, SITE_BRAND_AR, SITE_DESCRIPTION, SITE_DESCRIPTION_AR } from '@/consts';
import { homeHref } from '@/lib/blog';
import { citiesHref } from '@/lib/cities';
import { pageHref } from '@/lib/pages';
import { useTranslations, type Locale } from '@/i18n/ui';

interface Props {
	lang: Locale;
	alternateUrl?: string;
}

const { lang, alternateUrl } = Astro.props;
const t = useTranslations(lang);

const navLinks = [
	{ href: homeHref(lang), label: t('nav.home') },
	{ href: citiesHref(lang), label: t('nav.destinations') },
	{ href: `${homeHref(lang)}#guides`, label: t('nav.guides') },
	{ href: pageHref('about', lang), label: t('nav.about') },
	{ href: pageHref('why-wfrlee', lang), label: t('nav.why') },
];

const path = Astro.url.pathname;
const isActive = (href: string) => {
	if (href.includes('#')) return false;
	if (href === homeHref(lang)) return path === homeHref(lang);
	return path.startsWith(href);
};
---

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur">
	<div class="container-page flex h-16 items-center justify-between gap-4">
		<a
			href={homeHref(lang)}
			class="flex items-center gap-2.5 rounded-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand-600"
		>
			<Image
				src={logo}
				alt="Wfrlee logo"
				width={36}
				height={36}
				loading="eager"
				class="h-9 w-9 flex-none rounded-lg object-contain"
			/>
			<span class="flex flex-col leading-tight">
				{
					lang === 'ar' ? (
						<span lang="ar" dir="rtl" class="text-lg font-bold tracking-tight text-slate-900">
							{SITE_BRAND_AR}
						</span>
					) : (
						<span class="text-lg font-bold tracking-tight text-slate-900">
							Wfrlee<span class="text-brand-600">.com</span>
						</span>
					)
				}
			</span>
			<span class="sr-only">{lang === 'ar' ? SITE_DESCRIPTION_AR : SITE_DESCRIPTION}</span>
		</a>

		<nav aria-label="Primary" class="hidden lg:block">
			<ul class="flex items-center gap-6">
				{
					navLinks.map((link) => (
						<li>
							<a
								href={link.href}
								aria-current={isActive(link.href) ? 'page' : undefined}
								class:list={[
									'text-sm font-medium transition-colors hover:text-brand-700',
									isActive(link.href) ? 'text-brand-700' : 'text-slate-600',
								]}
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="flex items-center gap-2">
			{
				alternateUrl && (
					<a
						href={alternateUrl}
						lang={lang === 'en' ? 'ar' : 'en'}
						class="hidden items-center gap-1.5 rounded-lg border border-slate-200 px-3 py-2 text-sm font-semibold text-slate-600 transition-colors hover:border-brand-300 hover:text-brand-700 sm:inline-flex"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="16"
							height="16"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<circle cx="12" cy="12" r="10"></circle>
							<path d="M2 12h20"></path>
							<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
							></path>
						</svg>
						{t('lang.switch')}
					</a>
				)
			}

			<a
				href={BOOKING_URL}
				target="_blank"
				rel="noopener noreferrer"
				class="hidden rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-brand-700 sm:inline-flex"
			>
				{t('nav.book')}
			</a>

			<details class="group relative lg:hidden">
				<summary
					class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-lg border border-slate-200 text-slate-600 [&::-webkit-details-marker]:hidden"
					aria-label={t('nav.menu')}
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="20"
						height="20"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						aria-hidden="true"
					>
						<line x1="4" y1="7" x2="20" y2="7"></line>
						<line x1="4" y1="12" x2="20" y2="12"></line>
						<line x1="4" y1="17" x2="20" y2="17"></line>
					</svg>
				</summary>
				<div class="absolute end-0 mt-2 w-56 rounded-xl border border-slate-200 bg-white p-2 shadow-lg">
					<ul class="flex flex-col">
						{
							navLinks.map((link) => (
								<li>
									<a
										href={link.href}
										class="block rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 hover:text-brand-700"
									>
										{link.label}
									</a>
								</li>
							))
						}
						<li class="mt-1 border-t border-slate-100 pt-1">
							<a
								href={BOOKING_URL}
								target="_blank"
								rel="noopener noreferrer"
								class="block rounded-lg px-3 py-2 text-sm font-semibold text-brand-700 hover:bg-brand-50"
							>
								{t('nav.book')}
							</a>
						</li>
						{
							alternateUrl && (
								<li>
									<a
										href={alternateUrl}
										lang={lang === 'en' ? 'ar' : 'en'}
										class="block rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 hover:text-brand-700"
									>
										{t('lang.switch')}
									</a>
								</li>
							)
						}
					</ul>
				</div>
			</details>
		</div>
	</div>
</header>
