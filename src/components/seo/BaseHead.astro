---
import { Font } from 'astro:assets';
import {
	SITE_TITLE,
	SITE_TITLE_AR,
	SITE_DESCRIPTION,
	SITE_LOCALES,
	TWITTER_HANDLE,
	DEFAULT_OG_IMAGE,
	siteKeywords,
} from '@/consts';
import { defaultLang, languages, type Locale } from '@/i18n/ui';

interface Props {
	title: string;
	lang: Locale;
	description?: string;
	image?: string;
	type?: 'website' | 'article';
	canonicalURL?: URL | string;
	alternateUrl?: string;
	publishedTime?: Date;
	modifiedTime?: Date;
	author?: string;
	/** Page-specific keywords, merged with the site-wide base keyword list. */
	keywords?: string[];
	noindex?: boolean;
}

const {
	title,
	lang,
	description = SITE_DESCRIPTION,
	image = DEFAULT_OG_IMAGE,
	type = 'website',
	canonicalURL,
	alternateUrl,
	publishedTime,
	modifiedTime,
	author,
	keywords = [],
	noindex = false,
} = Astro.props;

// Merge the shared base keywords with any page-specific ones, de-duplicated
// case-insensitively while preserving order.
const metaKeywords = [...siteKeywords(lang), ...keywords].filter(
	(keyword, index, list) =>
		list.findIndex((entry) => entry.toLowerCase() === keyword.toLowerCase()) === index,
);

const siteName = lang === 'ar' ? SITE_TITLE_AR : SITE_TITLE;
const pageTitle = title === siteName ? title : `${title} | ${siteName}`;

const canonical = canonicalURL
	? new URL(canonicalURL, Astro.site)
	: new URL(Astro.url.pathname, Astro.site);

const alternate = alternateUrl ? new URL(alternateUrl, Astro.site) : undefined;

// x-default points at the default-language (English) version of this URL.
// When a translated counterpart does not exist, there is no English version of
// this page to advertise, so x-default is omitted rather than pointing at an
// unrelated URL (which Google would treat as a false equivalence).
const xDefault = lang === defaultLang ? canonical : (alternate ?? undefined);

const ogImage = new URL(image, Astro.site);
const ogUrl = new URL(Astro.url.pathname, Astro.site);

const otherLang: Locale = lang === 'en' ? 'ar' : 'en';
const rssUrl = new URL(lang === defaultLang ? 'rss.xml' : `${lang}/rss.xml`, Astro.site);
---

<!-- Global metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" sizes="any" />

<!-- Feeds & sitemap discovery -->
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={`${siteName} (${languages[lang]})`}
	href={rssUrl}
/>

<!-- Language alternates -->
<link rel="alternate" hreflang={lang} href={canonical} />
{alternate && <link rel="alternate" hreflang={otherLang} href={alternate} />}
{xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}

<!-- Performance: preload the webfont that paints first to protect LCP -->
<Font cssVariable="--font-sans" preload />

<!-- Primary meta tags -->
<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={author ?? siteName} />
<meta name="keywords" content={metaKeywords.join(', ')} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Canonical URL -->
<link rel="canonical" href={canonical} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={SITE_LOCALES[lang]} />
<meta property="og:locale:alternate" content={SITE_LOCALES[otherLang]} />
<meta property="og:url" content={ogUrl} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={title} />
{publishedTime && (
	<meta property="article:published_time" content={publishedTime.toISOString()} />
)}
{modifiedTime && (
	<meta property="article:modified_time" content={modifiedTime.toISOString()} />
)}
{author && <meta property="article:author" content={author} />}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={TWITTER_HANDLE} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
