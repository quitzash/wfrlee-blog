{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/about/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/ai/generate-post/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/newsletter/send/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/newsletter/subscribe/?$",
			"dest": "_render"
		},
		{
			"src": "^/ar/about/?$",
			"dest": "_render"
		},
		{
			"src": "^/ar/cities/?$",
			"dest": "_render"
		},
		{
			"src": "^/ar/rss\\.xml/?$",
			"dest": "_render"
		},
		{
			"src": "^/ar/styleguide/?$",
			"dest": "_render"
		},
		{
			"src": "^/ar/why-wfrlee/?$",
			"dest": "_render"
		},
		{
			"src": "^/ar/?$",
			"dest": "_render"
		},
		{
			"src": "^/cities/?$",
			"dest": "_render"
		},
		{
			"src": "^/robots\\.txt/?$",
			"dest": "_render"
		},
		{
			"src": "^/rss\\.xml/?$",
			"dest": "_render"
		},
		{
			"src": "^/styleguide/?$",
			"dest": "_render"
		},
		{
			"src": "^/why-wfrlee/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
